# URL base da API pública do Comunica PJe (DJEN). Normalmente não precisa ser alterada.
COMUNICA_API_URL=https://comunicaapi.pje.jus.br/api/v1/comunicacao

# ---------- Banco de dados ----------

# PostgreSQL (ex.: Supabase em São Paulo). Sem esta variável, os dados ficam em arquivos em DATA_DIR.
# Depois de configurar: npm run db:migrar (cria as tabelas) e, se vier da versão em arquivos,
# npm run db:importar (copia .data/ para o banco). Veja docs/decisoes/0006-postgres-e-rls.md.
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# PDFs dos processos no Supabase Storage (bucket privado "processos"). Use a chave service_role,
# que fica só no servidor. Sem estas variáveis, os PDFs ficam em DATA_DIR/arquivos, o que só
# serve para testar: num servidor que é recriado a cada publicação, os arquivos se perdem.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=processos

# Busca automática dos clientes por OAB e processo. Ligada por padrão em produção e desligada
# em desenvolvimento; use "ligada" ou "desligada" para forçar.
# RONDA_COMUNICA=ligada
# De quantas em quantas horas a busca roda (padrão 6).
# RONDA_COMUNICA_INTERVALO_HORAS=6
# Segredo para um agendador externo chamar POST /api/rondas/comunica (Authorization: Bearer ...).
# RONDA_TOKEN=um-segredo-longo

# Andamentos dos processos pela API pública do DataJud (CNJ). Não precisa de cadastro: o Clepsa usa a
# chave pública divulgada pelo CNJ. Se o CNJ trocar a chave, ponha a nova aqui.
# DATAJUD_API_KEY=
# Consulta diária automática (cada processo uma vez por dia). Ligada por padrão em produção.
# Um agendador externo pode chamar POST /api/rondas/datajud com o mesmo RONDA_TOKEN.
# RONDA_DATAJUD=ligada

# Segredo (32+ caracteres) que assina o link "Já cumpri" dos avisos de prazo. Sem ele, um é gerado
# e guardado em DATA_DIR/segredo-links.
# LINKS_SECRET=

# Resumo das intimações em duas linhas pela API da Anthropic (Claude). Sem a chave, o Clepsa funciona
# normalmente e mostra o começo do texto. Com ela, o texto das intimações é enviado à Anthropic.
# A mesma chave liga a análise de risco dos processos: os PDFs anexados vão para a Anthropic.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Google Agenda (opcional). Crie um "ID do cliente OAuth" do tipo "Aplicativo da Web" no Google Cloud,
# ative a Google Calendar API e cadastre como URI de redirecionamento: <APP_URL>/api/google/retorno
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------- Autenticação (Versão 2) ----------

# Endereço público da aplicação, usado nos links dos e-mails. Obrigatório em produção.
# APP_URL=https://intimacoes.seuescritorio.com.br

# Pasta onde ficam usuários, sessões e espaços de trabalho (padrão: ./.data; na Vercel, /tmp/clepsa).
# DATA_DIR=./.data

# Envio de e-mails: console (padrão, caixa de saída local em /dev/caixa-de-saida), smtp ou resend.
EMAIL_PROVIDER=console
# EMAIL_FROM="Clepsa <nao-responda@seuescritorio.com.br>"

# SMTP (Gmail com senha de app, Outlook/Office 365, Amazon SES, servidor próprio…)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=voce@gmail.com
# SMTP_PASSWORD=senha-de-app

# Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx

# Mostra a caixa de saída de desenvolvimento mesmo com `npm start` (não use em produção real).
# ENABLE_DEV_OUTBOX=true

# Nome exibido no aplicativo autenticador (Google Authenticator etc.).
# TOTP_ISSUER=Clepsa
